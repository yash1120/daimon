# ── LLM (required for real letters) ───────────────────────────────
# Get a free key at https://console.groq.com (no credit card needed)
GROQ_API_KEY=gsk_your_key_here
DAIMON_MODEL=llama-3.3-70b-versatile

# ── You ────────────────────────────────────────────────────────────
DAIMON_USER=Friend
DAIMON_DB=daimon.db
DAIMON_PHILOSOPHER=seneca

# ── RAG backend ────────────────────────────────────────────────────
# "chroma" (default, vector search; downloads a ~79MB embedding model on
# first use, then cached) or "tfidf" (instant, offline, no download).
DAIMON_RAG_BACKEND=chroma

# ── Public deploy: rate limits (protect your shared Groq key) ──────
DAIMON_RATE_SESSION_PER_HOUR=20
DAIMON_RATE_GLOBAL_PER_DAY=500

# ── Daily email delivery (optional) ────────────────────────────────
# Free tier at https://resend.com
RESEND_API_KEY=
DAIMON_TO_EMAIL=
DAIMON_FROM_EMAIL=Daimon <onboarding@resend.dev>
# DAIMON_DRY_RUN=1   # render + print emails instead of sending

# ── Neo4j theme-graph export (optional) ────────────────────────────
# Only used with: daimon themes --neo4j   (pip install neo4j)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
